# Copy to .env and fill in.

# Which station driver to use: ambient-cloud | simulator
STATION_DRIVER=ambient-cloud

# --- ambient-cloud ---------------------------------------------------------
# Create both keys at https://ambientweather.net/account (API Keys section).
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
# Optional: limit to specific station(s) by MAC address, comma-separated.
# AMBIENT_MAC_ADDRESS=00:0E:C6:20:00:00

# --- general ---------------------------------------------------------------# Host port the dashboard is published on (docker-compose only).
HOST_PORT=8080
# Time zone for the container (logs; "today" boundaries use the station's zone).
TZ=America/Chicago
# Days of history to fetch from the cloud on startup to fill gaps (0 disables).
BACKFILL_DAYS=7
# Days of history to keep in SQLite (0 keeps everything).
RETENTION_DAYS=365
# Minimum seconds between stored live readings (every reading is still shown live).
STORE_INTERVAL_SECONDS=60
LOG_LEVEL=info
